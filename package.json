{
  "name": "frame-film-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Persian RTL film and series catalog for GitHub Pages.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "publish:pages": "npm run build && node scripts/publish-pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-8080} --strictPort"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0"
  },
  "devDependencies": {
    "vite": "^6.4.6"
  },
  "engines": {
    "node": ">=18"
  }
}
