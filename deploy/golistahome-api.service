# گلیستا — واحد systemd برای API فروشگاه (Node بدون وابستگی).
# install.sh این فایل را با جایگزینی __APPDIR__ و __NODE__
# در /etc/systemd/system/golistahome-api.service نصب می‌کند.
#
# تنظیمات (API_PORT و …) از __APPDIR__/server/.env خوانده می‌شود؛
# دیتابیس و تصاویر آپلودشده در __APPDIR__/server/data/ نگهداری می‌شوند.
[Unit]
Description=Golistahome flower shop API (products, orders, admin panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__APPDIR__/server
EnvironmentFile=-__APPDIR__/server/.env
Environment=DATA_DIR=__APPDIR__/server/data
Environment=SHOP_DIR=__APPDIR__/shop
ExecStart=__NODE__ server.mjs
Restart=on-failure
RestartSec=3
# کمی سخت‌گیری امنیتی (برای VPS تک‌برنامه‌ای مناسب است):
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=__APPDIR__/server/data

[Install]
WantedBy=multi-user.target
