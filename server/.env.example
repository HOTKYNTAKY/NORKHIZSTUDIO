# گلیستا — متغیرهای محیطی سرور فروشگاه
# (install.sh این فایل را در اولین نصب به server/.env کپی می‌کند؛
#  دستی ویرایش نکنید مگر بدانید چه می‌کنید.)
#
# پورت داخلی API + پنل ادمین. در حالت استاندارد Nginx پورت را از بیرون
# می‌بندد و فقط مسیر /admin را پروکسی می‌کند؛ پس پنل از:
#   https://YOUR-DOMAIN/admin
# در دسترس است (پورت عمومی لازم نیست).
API_PORT=9273

# پوشه دیتابیس و تصاویر آپلودشده (chmod 700 — شامل هش رمز ادمین).
# پیش‌فرض: ./data کنار server.mjs
# DATA_DIR=/var/www/golistahome-server-data

# پوشه فرانت‌اند (برای حالت توسعه/پیش‌نمایش؛ در سرور Nginx استاتیک را
# خودش از /var/www/golistahome سرو می‌کند).
# SHOP_DIR=/var/www/golistahome
