# ============================================================================
# VELVETVAULT PRO — ENTERPRISE ADULT VOD & STREAMING PLATFORM (UBUNTU SERVER)
# ============================================================================

# --- Server Configuration ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DOMAIN=stream.example.com

# --- Secret Admin Panel Security ---
# Secret access key to unlock the hidden Admin Vault (Default: VAULT-ADMIN-2026)
ADMIN_SECRET_KEY=VAULT-ADMIN-2026
# Secondary Master PIN for destructive actions
ADMIN_MASTER_PIN=8899
# Custom stealth URL path for the hidden admin portal
ADMIN_STEALTH_PATH=/vault-x9-control
# Session token expiration in hours
ADMIN_SESSION_TTL_HOURS=24

# --- Official National License & Compliance Settings ---
LICENSE_ACTIVE=true
LICENSE_NUMBER=IR-AVOD-2026-99481-OFFICIAL
LICENSE_AUTHORITY=National Digital Media & Adult Content Regulatory Board
AGE_VERIFICATION_REQUIRED=true
MINIMUM_AGE=18

# --- Media & Streaming Storage ---
MAX_UPLOAD_SIZE_MB=8192
UPLOAD_DIR=./public/uploads
ENABLE_HLS_TRANSCODING=true
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
CDN_BASE_URL=

# --- Security & Anti-Leech ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=180
ENABLE_HOTLINK_PROTECTION=false
